# Database Configuration
# Default is SQLite for standalone runs; for PostgreSQL: postgresql://user:password@localhost:5432/recon_db
DATABASE_URL=sqlite:///./recon.db

# Razorpay Webhook Configuration
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_key_recon_2026

# Financial Constants (Spec §4 and §8)
RECON_TOLERANCE=0.09
STANDARD_TAX_RATE=0.18

# LLM Configuration (Optional, falls back to built-in financial domain reasoning engine)
LLM_PROVIDER=auto
LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=your_gemini_or_openai_api_key_here
